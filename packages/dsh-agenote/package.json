{
  "name": "dsh-agenote",
  "version": "0.1.4",
  "type": "module",
  "description": "DeepSeek Harness 的 agenote 集成插件：动态上下文注入记忆简报与召回、会话开始注入知识库健康度、turn 结束检测完成信号并转交 agenote-review 流程、宿主侧 agenote_write 写入工具，外加 /agenote-summarize|curate|health 斜杠命令。行为规范由 agenote-skills 定义，插件只做事件触发、注入通道、命令快捷入口与写入通道。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShineBreaker/agenote.git",
    "directory": "packages/dsh-agenote"
  },
  "bugs": {
    "url": "https://github.com/ShineBreaker/agenote/issues"
  },
  "homepage": "https://github.com/ShineBreaker/agenote/tree/main/packages/dsh-agenote",
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./hooks": "./hooks.js",
    "./commands": "./commands.js",
    "./tools": "./tools.js",
    "./lib": "./lib.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "hooks.js",
    "commands.js",
    "tools.js",
    "lib.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    }
  }
}
